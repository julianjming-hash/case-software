{
  "name": "case",
  "version": "0.0.0",
  "private": true,
  "description": "Case: facilitator-led clinical decision teaching at case.iatrogenic.app",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "check": "node scripts/check-case.mjs && node scripts/gen-spec.mjs --check && node scripts/gen-permissions.mjs --check",
    "audit:deps": "node scripts/audit-deps.mjs",
    "gen:spec": "node scripts/gen-spec.mjs",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning tests/*.test.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test:do": "vitest run --config vitest.config.mjs",
    "test:load-gates": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning tests/load-gates/*.test.mjs",
    "test:load150": "node --test --disable-warning=ExperimentalWarning tests/load/load-room-150.test.mjs",
    "test:runtime": "node --test --disable-warning=ExperimentalWarning tests/transport.test.mjs",
    "test:real": "playwright test --config playwright.config.mjs e2e/room-real.spec.mjs",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "test:e2e:shard": "node scripts/e2e-shard.mjs",
    "test:a11y": "playwright test --config playwright.config.mjs --grep \"axe on every window\"",
    "load:room": "node scripts/load-room.mjs",
    "deploy:guard": "node scripts/deploy-guard.mjs",
    "deploy": "node scripts/predeploy.mjs --env production --prod",
    "verify": "npm run size:client && npm run check && npm test && npm run test:do && npm run test:db",
    "predeploy": "node scripts/predeploy.mjs --npm-hook",
    "predeploy:staging": "node scripts/predeploy.mjs --npm-hook",
    "deploy:staging": "node scripts/predeploy.mjs --env staging",
    "build:client": "node scripts/build-client.mjs",
    "size:client": "node scripts/size-budget.mjs",
    "test:devices": "playwright test --config playwright.devices.config.mjs --workers=1",
    "test:load10": "node scripts/load-room.mjs --rooms 10 --clients 25 --stagger 1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.63.0",
    "es-module-lexer": "2.3.2",
    "esbuild": "0.28.1",
    "fast-check": "4.4.0",
    "miniflare": "5.20261001.0-alpha",
    "stylelint": "17.16.0",
    "vitest": "4.1.12",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "vite": "^8.3.3",
    "zod": "^4.6.6",
    "fast-uri": "3.1.9"
  }
}
